# Copia este archivo como .env y cambia los valores. El .env no se sube al repositorio.

# Contraseñas de MySQL
MYSQL_PASSWORD=cambia-esta-contraseña
MYSQL_ROOT_PASSWORD=cambia-esta-otra

# Clave para firmar los tokens JWT: al menos 32 caracteres aleatorios.
# Por ejemplo: openssl rand -base64 48
JWT_KEY=

# Puerto de la API en el equipo
API_PORT=8080

# Página de pruebas de la API en /swagger (útil en desarrollo; false en producción)
SWAGGER_ENABLED=true
